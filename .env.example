# Database
DATABASE_URL=postgres://randscan:randscan@localhost:5432/randscan
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=300

# RPC Node
RPC_URL=http://localhost:8899
POLL_INTERVAL_MS=500
BATCH_SIZE=100
FINALITY_DEPTH=32

# API Server
API_HOST=0.0.0.0
API_PORT=3000
ENABLE_CORS=true
CORS_ORIGINS=*
RATE_LIMIT_RPM=100
REQUEST_TIMEOUT=30

# WebSocket
ENABLE_BROADCAST=true

# Logging
RUST_LOG=info
