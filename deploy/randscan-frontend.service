[Unit]
Description=RandScan frontend (Next.js)
After=network-online.target randscan-api.service

[Service]
WorkingDirectory=/opt/randscan-frontend
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# DB-IP Country Lite, fetched by vps-setup.sh: picks a first visitor's language at /.
Environment=GEOIP_DB=/etc/randscan/geoip/dbip-country-lite.mmdb
ExecStart=/usr/bin/node /opt/randscan-frontend/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
