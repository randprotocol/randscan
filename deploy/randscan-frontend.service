[Unit]
Description=RandScan frontend (Next.js)
After=network-online.target randscan-api.service

[Service]
WorkingDirectory=/opt/randscan-frontend
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/randscan-frontend/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
