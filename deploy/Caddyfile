# RandScan: __DOMAIN__ is canonical; www and the .com mirror redirect to it.
# API and WebSocket are served by randscan-api on :3000, pages by Next.js on :3001.

__DOMAIN__ {
	encode gzip zstd

	# The sale service's upstream (randprotocol.org's server/sale, SALE_RPC_UPSTREAM
	# = https://__DOMAIN__/rpc): the node RPC admitted from the web droplet only.
	# vps-setup.sh re-renders this file on every deploy — keep this route in the
	# template or randprotocol.org's /account loses the chain's token names.
	@rpc {
		path /rpc
		remote_ip 159.65.138.161
	}
	handle @rpc {
		rewrite * /
		reverse_proxy 127.0.0.1:8545
	}
	@rpc_denied path /rpc
	handle @rpc_denied {
		respond 403
	}

	@api path /api/* /ws
	handle @api {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3001
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.__DOMAIN__, randscan.com, www.randscan.com {
	redir https://__DOMAIN__{uri} permanent
}
