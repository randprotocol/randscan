# Leave both empty in production: the frontend is served behind the same origin
# as the API (Caddy proxies /api/* and /ws to randscan-api), so requests go to
# /api/v1/... and ws(s)://<host>/ws automatically.

# Point the browser at an API on a different origin (local development):
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://localhost:3000
